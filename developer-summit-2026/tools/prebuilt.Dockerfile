# Workshop image for an MFE generated with create-mfe-app. Used by `task image`.
#
# Your project also has a `Dockerfile`, generated by create-mfe-app. We don't use that one
# in the workshop: it runs `npm install` for the client inside the image build, which needs
# access to the @milestone npm registry, and your `npm-auth` login isn't available there.
#
# This one runs nothing that needs the @milestone registry. It copies the client and server
# you've already built in the dev container (`task mfe:build`), so build those first.
# Run from your project folder (that's what `task image` does):
#   docker build --platform linux/amd64 -f ../tools/prebuilt.Dockerfile -t <image>:<version> .

FROM node:24-slim

ENV NODE_ENV=production

WORKDIR /app

# Client built with `NODE_ENV=production npm run build:federation`
COPY client/dist/ ./client/dist/

# Server built with `npm run build`
COPY server/dist/ ./server/dist/
COPY server/server.json server/package.json server/package-lock.json* ./server/

# The server only has public dependencies, so this needs no @milestone registry access
WORKDIR /app/server
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

EXPOSE 3003

CMD ["node", "dist/server.js"]
